{
  "manifest_version": 3,
  "name": "Local File Explorer",
  "version": "0.2.0",
  "description": "Query Everything HTTP server and page the results.",
  "action": { "default_title": "Local File Explorer" },
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "http://localhost:9090/*",
    "http://127.0.0.1:9090/*"
  ]
}
